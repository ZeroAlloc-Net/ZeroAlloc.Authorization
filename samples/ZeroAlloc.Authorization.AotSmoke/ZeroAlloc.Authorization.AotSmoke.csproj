<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <OptimizationPreference>Size</OptimizationPreference>
    <RootNamespace>ZeroAlloc.Authorization.AotSmoke</RootNamespace>
    <NoWarn>$(NoWarn);MA0002;MA0004;MA0047;MA0048</NoWarn>

    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2067;IL2075;IL2091;IL3050;IL3051</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="ZeroAlloc.TestHelpers" Version="1.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>contentfiles;build</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZeroAlloc.Authorization\ZeroAlloc.Authorization.csproj"
                      SetTargetFramework="TargetFramework=net10.0" />
    <!-- Direct analyzer wiring so the generator runs for this sample. The
         ZeroAlloc.Authorization project references the generator with
         PrivateAssets="all", which intentionally hides the analyzer from
         downstream consumers, so it is re-attached here. The ProjectReference
         resolves the DLL the build actually produced; a hard-coded bin path missed
         any output redirection such as artifacts-path and loaded a stale DLL, or
         none at all. See ZeroAlloc-Net/.github#43. PublishAot is set in this file,
         not passed globally, so it does not reach the netstandard2.0 generator. -->
    <ProjectReference Include="..\..\src\ZeroAlloc.Authorization.Generator\ZeroAlloc.Authorization.Generator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
